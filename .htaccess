DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Redirect www to non-www (canonical domain; GSC shows both versions indexed)
  RewriteCond %{HTTP_HOST} ^www\.receipts-maker\.com$ [NC]
  RewriteRule ^(.*)$ https://receipts-maker.com/$1 [R=301,L]


  # 1. Redirect /index.html to / and /folder/index.html to /folder/ (Clean URLs)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+index\.html[\ ?]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.+)/index\.html[\ ?]
  RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

  # 2. Handle dynamic SPA routes (like /receipt/123)
  RewriteCond %{REQUEST_URI} ^/receipt/.*$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^receipt/.*$ receipt/index.html [L]

  # 3. Handle trailing slash redirection for directories
  # If a directory is requested without a trailing slash, redirect to trailing slash version.
  # Uses REQUEST_URI to prevent redirect loops on LiteSpeed servers.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ %{REQUEST_URI}/ [R=301,L]
</IfModule>

# Handle 404 Errors correctly
ErrorDocument 404 /404/index.html
